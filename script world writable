#!/bin/sh

LOG="/var/log/world_writable_fix.log"

echo "===== Started: $(date) =====" >> "$LOG"

# World-writable files -> 644
find /opt/batchlogs/qsb/smsmandates /opt/sbi/wac \
-type f -perm -0002 -print 2>/dev/null |
while IFS= read -r FILE
do
    OLD_PERM=$(ls -ld "$FILE" | awk '{print $1}')
    echo "$(date): Changing file $FILE from $OLD_PERM to 644" >> "$LOG"
    chmod 644 "$FILE"
done

# World-writable directories -> 755
find /opt/batchlogs/qsb/smsmandates /opt/sbi/wac \
-type d -perm -0002 -print 2>/dev/null |
while IFS= read -r DIR
do
    OLD_PERM=$(ls -ld "$DIR" | awk '{print $1}')
    echo "$(date): Changing directory $DIR from $OLD_PERM to 755" >> "$LOG"
    chmod 755 "$DIR"
done

echo "===== Completed: $(date) =====" >> "$LOG"